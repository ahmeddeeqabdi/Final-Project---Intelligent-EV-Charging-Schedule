# Required outside the local Spring profile. Use a long, randomly generated value.
APP_JWT_SECRET=replace-with-at-least-32-random-characters

# Comma-separated frontend origins allowed to call the API.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_JWT_EXPIRATION_MS=3600000

# PostgreSQL settings matching compose.yaml.
DB_URL=jdbc:postgresql://localhost:5432/mydatabase
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Optional Compose overrides.
POSTGRES_DB=mydatabase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
